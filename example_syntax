3. Variables and simple type inference
--------------------------------------

int main()
    age = 42
    temperature = 19.5
    initial = 'A'
    message = "ready"
    active = True

    print("age={age}")
    print("temperature={temperature}")
    print("initial={initial}")
    print("message={message}")
    print("active={active}")

    age = age + 1
    print("new age={age}")

    return 0

Notes:
- True becomes true.
- False becomes false.
- A first assignment declares a variable.
- A later assignment updates the existing variable.
- Identifiers must start with a letter or underscore.


4. Functions
------------

int square(int x)
    return x * x

int sum_until(int n)
    total = 0
    for i in range(n):
        total = total + i
    return total

int main()
    x = 6
    square_result = square(x)
    sum_result = sum_until(5)
    print("square={square_result}, sum={sum_result}")
    return 0


5. Conditions
-------------

int main()
    score = 12

    if score >= 10:
        print("passed")
    else:
        print("try again")

    if score == 12:
        print("perfect score")

    return 0

The colon is accepted after if and else. Indentation is still required.


6. while loop
-------------

int main()
    i = 0

    while i < 3:
        print("i={i}")
        i = i + 1

    return 0


7. for loop with range
----------------------

int main()
    for i in range(5):
        print("turn {i}")

    return 0

Conceptual C translation:

for (int i = 0; i < 5; i++)


8. print and interpolation
--------------------------

int main()
    name = "Ada"
    age = 36
    total = 7 + 5
    numbers = [10, 20, 30]

    print("name={name}")
    print("age={age}, total={total}")
    print(age)
    print("first number={numbers[0]}")

    return 0

Interpolation uses {variable} inside a double-quoted string.
Interpolations must be closed and cannot be empty.


9. Integer lists
----------------

int main()
    numbers = [10, 20, 30, 40]

    print("length={numbers_len}")
    print("first={numbers[0]}")
    print("second={numbers[1]}")

    return 0

A list creates:
- a dynamically allocated array named numbers;
- a length variable named numbers_len;
- automatic free calls before return and when the current block closes.


10. Lists of other types
------------------------

int main()
    notes = [12.5, 15.0, 18.5]
    words = ["one", "two", "three"]
    flags = [true, false, true]

    print("first note={notes[0]}")
    print("first word={words[0]}")
    print("first flag={flags[0]}")

    return 0

Lists must be homogeneous.

Rejected example:

int main()
    mixed = [1, 2.5, "text"]
    return 0


11. List decomposition with ::
-----------------------------

int main()
    numbers = [10, 20, 30]

    head::tail = numbers

    print("head={head}")
    print("tail length={tail_len}")
    print("first tail item={tail[0]}")

    return 0

The line head::tail = numbers creates:
- head, equal to numbers[0];
- tail, pointing to numbers + 1;
- tail_len, equal to numbers_len - 1.


12. match on a value
--------------------

int main()
    code = 2

    match code with
        | 0 -> print("zero")
        | 1 -> print("one")
        | 2 -> print("two")
        | _ -> print("other")

    return 0

Conceptual C translation:

if (code == 0)
    ...
else if (code == 1)
    ...
else if (code == 2)
    ...
else
    ...


13. match with guards
---------------------

int main()
    n = 15

    match n with
        | _ if n < 0 -> print("negative")
        | _ if n == 0 -> print("zero")
        | _ if n > 10 -> print("large positive")
        | _ -> print("small positive")

    return 0

A guard uses this shape:

| _ if condition -> action


14. match on a list
-------------------

int main()
    items = [10, 20, 30]

    match items with
        | [] -> print("empty list")
        | [x] -> print("one item: {x}")
        | head::tail -> print("many items, first={head}, rest={tail_len}")

    return 0

Supported list patterns:
- [] matches an empty list.
- [x] matches a single-item list and binds the item to x.
- head::tail matches a non-empty list, binds the first element, and binds the rest.


15. Comments in .l files
------------------------

int main()
    # This becomes a C comment in the generated file
    value = 123
    print("value={value}")
    return 0

Lines starting with # are directives when recognized.
Unknown # lines in .l files become C comments.


16. Include directives
----------------------

#all
#linux

int main()
    print("includes were added")
    return 0

.l files already generate these base includes:
- stdio.h
- stdlib.h
- stdbool.h
- string.h

#all adds:
- math.h
- time.h

#linux adds:
- unistd.h
- sys/types.h
- sys/wait.h

.H files also support:
- #windows, which includes windows.h
- #mac, which includes TargetConditionals.h and Availability.h


17. Child and parent process helpers
------------------------------------

#linux

int main()
    #process
    #enfant
        print("inside the child process")
        return 0
    #parent basic
        print("inside the parent after waitpid")

    return 0

Notes:
- #process emits fork().
- #enfant emits if (pid == 0).
- #parent emits else.
- #parent basic emits else, waitpid, and an exit-status check.
- This depends on POSIX APIs.


