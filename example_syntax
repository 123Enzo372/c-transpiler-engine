For complex raw C, keep complete C syntax.


20. Passing gcc options
-----------------------

Compile with warnings:

./compilateur main.l -Wall -Wextra -o app

Translate, compile, and run in one command:

./compilateur run main.l

Create starter files without overwriting existing files:

./compilateur init my-app

Remove common local build artifacts:

./compilateur clean

Open the teaching REPL:

./compilateur repl

Print the local dependency graph:

./compilateur deps main.l

Compile with the math library:

./compilateur main.l -lm -o app

Translate only and keep the generated C:

./compilateur main.l -without-binary -keep_c

Translate only and keep generated C/header files with the shorter option:

./compilateur main.l --emit-c

Translate only and keep readable generated C with source comments:

./compilateur main.l -without-binary -keep_c -comments

Generate C with extra spacing around top-level functions:

./compilateur main.l --emit-c --pretty-c

Trace what the transpiler recognizes:

./compilateur main.l --emit-c --trace

Teaching mode: keep readable C and create a .explain.txt sidecar:

./compilateur main.l --teach

Add an extra concrete fix line to diagnostics:

./compilateur main.l --suggest-fix

Show the version:

./compilateur --version

Explain an error code:

./compilateur --explain E_ASSIGN_TYPE

Translate a header only and keep the generated header:

./compilateur api.H -without-binary -keep_h

Show command-line help:

./compilateur --help


21. Complete program
--------------------

Source: demo.l

#all
#linux

int square(int x)
    return x * x

int sum_until(int n)
    total = 0
    for i in range(n):
        total = total + i
    return total

int sum_between(int start, int stop)
    total = 0
    for i in range(start, stop):
        total = total + i
    return total

int main()
    name = input("Name: ")
    const limit = 5
    total = sum_until(limit)
    between = sum_between(2, 6)
    square_of_four = square(4)
    copied_name = str_copy(name)
    greeting = str_concat("Hello ", copied_name)

    print(greeting)
    print("name length = {str_len(copied_name)}")
    print("sum before {limit} = {total}")
    print("sum from 2 to 5 = {between}")
    print("square of 4 = {square_of_four}")

    values = [10, 20, 30]
    append(values, 40)
    insert(values, 1, 15)
    pop(values)
    print("values length={len(values)}")
    print("contains 15? {contains(values, 15)}")

    for value in values:
        print("foreach value={value}")

    head::tail = values
    print("first={head}, remaining={tail_len}")

    match total with
        | 0 -> print("zero")
        | _ if total > 5 and len(values) > 3 -> print("greater than five")
        | _ -> print("small total")

    match values with
        | [] -> print("no values")
        | [x] -> print("one value {x}")
        | head2::tail2 -> print("several values, first={head2}")

    return 0

Recommended command for learning:

./compilateur demo.l -without-binary -keep_c

Then open demo.c and compare it with demo.l.


22. Common errors
-----------------

Errors include the source location, the offending line, a caret, and a suggestion
when the transpiler can point to a useful source line.

Invalid identifier:

int main()
    123bad = 10
    return 0

Mixed list types:

int main()
    mixed = [1, 2.5, "text"]
    return 0

Malformed list decomposition:

int main()
    values = [1, 2, 3]
    head:: = values
    return 0

Malformed match:

int main()
    match with
        | 1 -> print("bad")
    return 0

Malformed print interpolation:

int main()
    value = 10
    print("value={value")
    return 0

Empty print interpolation:

int main()
    print("value={}")
    return 0

Malformed range:

int main()
    for i in range(1, 10, 2) extra:
        print(i)
    return 0

len on something that is not a declared list:

int main()
    name = "Ada"
    print(len(name))
    return 0

append on something that is not a declared list:

int main()
    name = "Ada"
    append(name, "!")
    return 0

Type mismatch in append:

int main()
    values = [1, 2, 3]
    append(values, "bad")
    return 0

Assigning to a const:

int main()
    const limit = 10
    limit = 20
    return 0

foreach without an indented block:

int main()
    values = [1, 2, 3]
    for value in values:
    return 0

Typical diagnostic shape:

ERROR E_APPEND_TARGET [Line 3] : append(...) expects an already declared list.
  --> demo.l:3
   |
   3 |     append(name, "!")
   |            ^
Suggestion: Create the list first with values = [] or values = [1, 2, 3].

Malformed import:

import ""

int main()
    return 0

Unexpected indentation:

int main()
    value = 1
        bad = 2
    return 0

Missing block body:

int main()
    if true:
    return 0

Invalid function return:

int value()
    return "bad"
